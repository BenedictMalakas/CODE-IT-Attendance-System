# ─── DATABASE CONNECTION ───────────────────────────────────────────
# Uncomment ONE of the lines below.

# LOCAL  (your own PC — PostgreSQL must be running):
# DATABASE_URL=postgresql://<YOUR_LOCAL_USER>:<YOUR_LOCAL_PASSWORD>@localhost:5432/<YOUR_DB_NAME>

# SUPABASE (online):
DATABASE_URL=postgresql://<SUPABASE_USER>:<SUPABASE_PASSWORD>@<SUPABASE_HOST>:5432/postgres
